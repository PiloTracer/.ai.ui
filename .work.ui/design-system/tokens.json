{
  "color": {
    "text": {
      "primary": { "$type": "color", "$value": "#1a1d21" },
      "secondary": { "$type": "color", "$value": "#5b6470" },
      "inverse": { "$type": "color", "$value": "#ffffff" }
    },
    "accent": { "$type": "color", "$value": "#2f6df6" },
    "accentText": { "$type": "color", "$value": "#ffffff" },
    "border": { "$type": "color", "$value": "#d8dce1" }
  },
  "surface": {
    "base": { "$type": "color", "$value": "#f6f7f9" },
    "elevated": { "$type": "color", "$value": "#ffffff" },
    "inset": { "$type": "color", "$value": "#eceef1" },
    "overlay": { "$type": "color", "$value": "#ffffffe6" },
    "page": { "$type": "color", "$value": "{surface.base}" }
  },
  "fontSize": {
    "100": { "$type": "fontSize", "$value": "0.875rem" },
    "200": { "$type": "fontSize", "$value": "1rem" },
    "300": { "$type": "fontSize", "$value": "1.25rem" },
    "400": { "$type": "fontSize", "$value": "1.75rem" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        { "color": "#1018280f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#1018281a", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
      ]
    },
    "inset": {
      "$type": "shadow",
      "$value": [ { "color": "#10182814", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "inset": true } ]
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter, system-ui, sans-serif", "fontSize": "{fontSize.200}", "lineHeight": 1.5, "fontWeight": 400 }
    }
  }
}
